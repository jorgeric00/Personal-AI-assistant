# Copia este fichero como .env y cambia los valores. El fichero .env nunca se sube al repositorio.

# Contraseña de la base de datos (inventa una larga).
LIFEOS_DB_PASSWORD=cambia-esta-contraseña

# Tu cuenta. Solo se usa la primera vez que arranca, cuando aún no existe ningún usuario.
LIFEOS_ADMIN_EMAIL=tu-correo@example.com
LIFEOS_ADMIN_PASSWORD=una-contraseña-de-al-menos-12-caracteres
LIFEOS_ADMIN_NAME=Jorge

# Pon true cuando la app se sirva por HTTPS (obligatorio fuera de tu ordenador).
LIFEOS_COOKIE_SECURE=false

# Puerto en el que se abre la app: http://localhost:8080
LIFEOS_HTTP_PORT=8080
